# AstraZit Music OS - Environment Configuration Example
# Copy this file to .env and replace placeholders with actual values.
# NEVER commit .env or real credentials to version control.
# Future integration examples only: no runtime consumes this file in Phase 0.
# Non-empty settings below are illustrative, not approved infrastructure or profiles.
# Confirm actual targets and technology choices in their implementation tickets.

# -----------------------------------------------------------------------------
# General Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Google Cloud Platform
# -----------------------------------------------------------------------------
# Human-approved Google Cloud project and region (not established in Phase 0)
GCP_PROJECT_ID=
GCP_REGION=
# Example local credential path; production authentication design is deferred.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Database / Canonical Storage
# -----------------------------------------------------------------------------
# Illustrative connection string only; database technology is not selected here.
DATABASE_URL=postgresql://user:password@localhost:5432/astrazit_music_os
DATABASE_POOL_SIZE=5

# -----------------------------------------------------------------------------
# AstraZit AST Identifier Authority (OS-004 / OS-006)
# -----------------------------------------------------------------------------
# Backend selection: 'local' (LocalJsonSequenceStore) or 'firestore' (FirestoreSequenceStore)
# LocalJsonSequenceStore is for local development / test contract verification only.
# FirestoreSequenceStore is the production identifier authority backend.
ASTRAZIT_ID_BACKEND=local
ASTRAZIT_GCP_PROJECT=
ASTRAZIT_FIRESTORE_DATABASE=(default)

# -----------------------------------------------------------------------------
# Gemini AI Services (Enrichment, Analysis - Offline / Non-Hot-Path)
# -----------------------------------------------------------------------------
# Gemini API Key for metadata enrichment, lyrics processing, and catalog intelligence
# NOTE: AI is strictly prohibited from executing in live radio song-change hot paths.
GEMINI_API_KEY=your_gemini_api_key_here
# Select and verify a supported model in the future integration ticket.
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# AstraZit Radio (Application #1)
# -----------------------------------------------------------------------------
# Radio Station / Stream Configuration
RADIO_STATION_NAME="AstraZit Radio"
RADIO_MOUNT_POINT=/live
RADIO_PORT=8000
RADIO_TELNET_PORT=1234
RADIO_ICECAST_HOST=localhost
RADIO_ICECAST_SOURCE_PASSWORD=change_me_icecast_source_password
RADIO_ICECAST_ADMIN_PASSWORD=change_me_icecast_admin_password

# -----------------------------------------------------------------------------
# YouTube Live Streaming (Application Output)
# -----------------------------------------------------------------------------
# RTMP ingest endpoint and stream key for continuous live broadcast
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# -----------------------------------------------------------------------------
# Media Storage Paths
# -----------------------------------------------------------------------------
# Local storage path for master audio cache / working directory
MEDIA_VAULT_PATH=/path/to/local/media/vault
TRANSCODE_CACHE_PATH=/path/to/local/transcode/cache
