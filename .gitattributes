# AstraZit Music OS - Git Attributes Configuration
# Enforces cross-platform line ending consistency across Windows development and Linux runtime.

# Set default behavior to normalize all text files to LF
* text=auto eol=lf

# Linux / Runtime files - strictly LF
*.sh text eol=lf
*.liq text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.env* text eol=lf

# Windows-specific scripts - CRLF allowed
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.flac binary
*.aac binary
*.ogg binary
*.mp4 binary
*.mkv binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
