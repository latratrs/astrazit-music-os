# AstraZit Music OS - .gitignore

# Environment & Secrets
secrets/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Service Accounts & GCP Credentials
*credentials*.json
*service_account*.json
*service-account*.json
*-sa.json
client_secret*.json
gcp-key*.json
google-credentials.json
cloud-creds/

# Local Media & Audio Libraries (Master files and raw assets must not be checked into Git)
*.wav
*.flac
*.mp3
*.aac
*.ogg
*.m4a
*.aiff
*.alac
*.opus
audio/
media/
library/
local_media/
music_vault/

# Scoped Radio runtime/generated media and local stream configuration
/apps/radio/assets/generated/
/apps/radio/stream.env
/apps/radio/runtime/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Node.js / Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/

# Logs & Temporary Files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# Operating System & IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# Liquidsoap / Streaming runtime artifacts
*.liq.pid
*.liq.log
stream_dump/
hls_segments/

# Local allocator state: use this directory for custom state filenames.
.local/allocator/
catalog_sequences.json
catalog_sequences.json.lock
catalog_sequences.json.initialized
.ast_seq_tmp_*

# Local mutable catalog repository state
/.local/catalog/
/.local/demo-catalog/
/catalog_root/

# Local radio playout runtime state, logs, and test music
.local/radio/
